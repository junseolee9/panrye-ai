# ── API 키 (전부 무료 발급) ─────────────────────────────
# Groq (필수): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (선택, Groq 장애 시 폴백): https://aistudio.google.com
GOOGLE_API_KEY=your_google_api_key_here

# 법제처 국가법령정보 OpenAPI (데이터 수집 시에만 필요): https://open.law.go.kr
LAW_API_KEY=your_law_api_key_here

# HuggingFace (인덱스 아티팩트 업로드 시에만 필요)
HF_TOKEN=your_hf_token_here

# ── 배포 ────────────────────────────────────────────────
# 인덱스 아티팩트 HF Dataset repo (예: username/panrye-index).
# 설정 시 서버 시작할 때 로컬 인덱스가 없으면 자동 다운로드.
INDEX_REPO_ID=

# ── 오버라이드 (선택, 기본값은 src/panrye/config.py) ──────
# LLM_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-1.5-flash
# CHROMA_DIR=./artifacts/chroma_db
# BM25_PATH=./artifacts/bm25_index.pkl
# DB_PATH=./logs/panrye.db
