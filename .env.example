# 법제처 국가법령정보 OpenAPI
# 발급: https://open.law.go.kr/LSO/main.do
LAW_API_KEY=your_law_api_key_here

# Groq (무료: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini (무료: https://aistudio.google.com)
GOOGLE_API_KEY=your_google_api_key_here

# HuggingFace (임베딩 Inference API, 무료)
HF_TOKEN=your_hf_token_here

# 설정
CHROMA_DB_PATH=./chroma_db
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5

# RAGAS 평가용 (eval/ragas_runner.py 실행 시에만 필요 — RAGAS 기본 judge가 OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here
